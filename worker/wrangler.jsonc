{
  "name": "v18-dashboard-server",
  "main": "worker.js",
  "compatibility_date": "2026-09-18",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "V18_STATE",
        "class_name": "V18State"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["V18State"]
    }
  ]
}
